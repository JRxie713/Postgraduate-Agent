# 环境变量模板：复制本文件为 backend/.env 后填写自己的值
# .env 已被 .gitignore 忽略，不会被提交；本模板可以提交
# 修改后需要重启后端

# 数据库（必填）
DB_USERNAME=你的数据库用户名
DB_PASSWORD=你的数据库密码
# 默认连接 127.0.0.1:3307/kaoyan，如不同请取消注释并修改
# DB_URL=jdbc:mysql://127.0.0.1:3307/kaoyan?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# Redis（可选，默认 127.0.0.1:6379；Redis 在 Ubuntu Docker 里时填 Ubuntu 的 IP）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Kafka（学习打卡事件异步消费；默认 127.0.0.1:9092，填 Ubuntu 的 IP:端口）
# KAFKA_BOOTSTRAP=127.0.0.1:9092

# RabbitMQ（可选，当前代码未实际使用；默认 127.0.0.1:5672）
# RABBITMQ_HOST=127.0.0.1
# RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# QQ 邮箱 SMTP（可选；不填则验证码只打印在后端日志 [MAIL-MOCK]，不会真正发信）
# MAIL_AUTH_CODE 是 QQ 邮箱生成的 16 位授权码，不是登录密码
MAIL_USERNAME=你的QQ邮箱
MAIL_AUTH_CODE=你的QQ邮箱授权码

# 图形验证码开关（默认 true；本地接口联调可临时设 false）
# CAPTCHA_ENABLED=true

# JWT 签名密钥（必填，至少 32 字节；可用 openssl rand -hex 32 生成）
JWT_SECRET=请替换为至少32字节的随机字符串

# ===== 实时聊天文件存储 =====
# local：存本机磁盘（默认，适合单实例本地开发）
# oss：阿里云对象存储（多实例部署必须用 oss，否则不同实例拿不到对方上传的文件）
# CHAT_STORAGE_TYPE=local
# CHAT_STORAGE_LOCAL_DIR=./data/chat-files

# 阿里云 OSS（CHAT_STORAGE_TYPE=oss 时必填）
# RAM 子账号建议只授予目标 bucket 的 oss:PutObject / oss:GetObject 权限
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=你的bucket名称
# OSS_ACCESS_KEY_ID=你的AccessKeyId
# OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
